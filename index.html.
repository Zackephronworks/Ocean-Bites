<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ocean Bites | Zackephron Works</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background: linear-gradient(to bottom, #87CEEB, #0077b6, #03045e);
            font-family: 'Segoe UI', sans-serif;
            transition: background 1s ease;
            user-select: none;
        }
        body.night-mode {
            background: linear-gradient(to bottom, #000814, #001d3d, #003566);
        }
        #ui-board {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.9);
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            border-top: 4px solid #ffb703;
            transition: all 0.5s ease;
            z-index: 10;
        }
        body.night-mode #ui-board {
            background: rgba(0, 8, 20, 0.9);
            color: #00f5ff;
            border-top: 4px solid #00f5ff;
            box-shadow: 0 0 20px #00f5ff;
        }
        .stat { font-size: 20px; color: #0a9396; font-weight: bold; margin-bottom: 5px; }
        body.night-mode .stat { color: #00f5ff; }
        button {
            margin-top: 10px;
            padding: 10px 15px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            background: #023047;
            color: white;
            transition: transform 0.1s;
        }
        button:active { transform: scale(0.95); }
        #night-btn { position: absolute; top: 20px; right: 20px; background: #ffb703; color: #023047; z-index: 10; }
        #sparky {
            position: absolute;
            bottom: 30px;
            right: 30px;
            background: #ffb703;
            color: #023047;
            padding: 15px 25px;
            border-radius: 30px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            z-index: 10;
        }
        .studio { font-size: 10px; color: #888; margin-top: 10px; text-transform: uppercase; }
        canvas { display: block; cursor: crosshair; }
    </style>
</head>
<body>

    <button id="night-btn" onclick="toggleNight()">🌙 Switch to Night</button>

    <div id="ui-board">
        <h1>🌊 Ocean Bites</h1>
        <div class="stat">🪙 Gold: <span id="gold-count">0</span></div>
        <div class="stat">🐟 Fish: <span id="fish-count">0</span></div>
        <button onclick="buyAuto()">🛒 Buy Sparky Auto ($100)</button>
        <div class="studio">© 2026 Zackephron Works</div>
    </div>

    <div id="sparky">Sparky: "Click the ocean! Let's get rich!"</div>
    <canvas id="ocean"></canvas>

    <script>
        const canvas = document.getElementById('ocean');
        const ctx = canvas.getContext('2d');
        const goldDisplay = document.getElementById('gold-count');
        const fishDisplay = document.getElementById('fish-count');
        const sparky = document.getElementById('sparky');

        let gold = 0;
        let fish = 0;
        let ripples = [];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        function toggleNight() {
            document.body.classList.toggle('night-mode');
            const btn = document.getElementById('night-btn');
            btn.innerText = document.body.classList.contains('night-mode') ? "☀️ Day Mode" : "🌙 Night Mode";
        }

        function buyAuto() {
            if (gold >= 100) {
                gold -= 100;
                goldDisplay.innerText = gold;
                sparky.innerText = "Sparky: 'I'm fishing for you now! Automation Baby!'";
                sparky.style.background = "#00f5ff";
                setInterval(() => {
                    fish++;
                    gold += 15;
                    goldDisplay.innerText = gold;
                    fishDisplay.innerText = fish;
                    ripples.push({ x: Math.random()*canvas.width, y: Math.random()*canvas.height, radius: 0, alpha: 1 });
                }, 3000);
            } else {
                sparky.innerText = "Sparky: 'You need $100 gold, Boss!'";
            }
        }

        canvas.addEventListener('click', (e) => {
            ripples.push({ x: e.clientX, y: e.clientY, radius: 0, alpha: 1 });
            fish++;
            gold += 10;
            goldDisplay.innerText = gold;
            fishDisplay.innerText = fish;
            if(gold < 100) sparky.innerText = "Sparky: 'Keep clicking! Almost at $100!'";
        });

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < ripples.length; i++) {
                let r = ripples[i];
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(255, 255, 255, ${r.alpha})`;
                ctx.lineWidth = 3;
                ctx.stroke();
                r.radius += 2;
                r.alpha -= 0.02;
            }
            ripples = ripples.filter(r => r.alpha > 0);
            requestAnimationFrame(draw);
        }
        draw();
    </script>
</body>
</html>
